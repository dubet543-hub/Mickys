# Package weight/dims used when creating shipments (defaults below if unset)
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

FRONTEND_URL=http://localhost:5500
ADMIN_EMAIL=admin@mickys.in
ADMIN_PASSWORD=Admin@12345

# Admin dashboard origin (for CORS); add to FRONTEND_URL handling if needed
ADMIN_URL=http://localhost:5174
